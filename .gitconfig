[user]
	email = 176315912+AJBvAntMet@users.noreply.github.com
	name = Anthony Metcalf
	signingkey = /home/ametca/.ssh/id_ed25519_signing.pub
[pull]
	rebase = true
[core]
	pager = batcat
[commit]
	gpgsign = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[init]
	defaultBranch = main
