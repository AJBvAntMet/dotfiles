[user]
	email = anthony.metcalf1@gmail.com
	name = Anthony Metcalf
	signingkey = 0F2150EA
[pull]
	rebase = true
[core]
	pager = bat
[commit]
	gpgsign = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[init]
	defaultBranch = main
